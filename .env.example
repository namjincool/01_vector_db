# Create a TypeSafe API key at https://console.typesafe.ai/ and store it only in .env.
# Never commit a real key here.
TYPESAFE_API_KEY=replace-with-your-typesafe-api-key

# Optional: set only when routing through a compatible proxy or private endpoint.
# TYPESAFE_ENDPOINT=https://your-typesafe-endpoint

# Stable Jev alias. It follows the newest official Jev release.
TYPESAFE_MODEL=jev-latest

